# AppliQ Environment Configuration Example
# Salin file ini menjadi `.env` dan isi dengan kredensial proyek Supabase Anda.
# PENTING: File `.env` sudah di-ignore oleh git agar kredensial tidak bocor ke public repository.

# Supabase Configuration
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your-anon-key-here

# Google OAuth Web Client ID (untuk native Google Sign-In serverClientId)
GOOGLE_WEB_CLIENT_ID=your-google-web-client-id.apps.googleusercontent.com

# Mode Demo / Mock Data (true = gunakan local mock repository tanpa Supabase, false = gunakan Supabase)
USE_MOCK_DATA=true
